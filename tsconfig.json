{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["vitest/globals"],
    "paths": {
      "~/*": ["./*"]
    },
    "allowUmdGlobalAccess": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", ".eslint.js", "app.config.js"]
}
